<div class="dh-sheet-root {{#unless editMode}}dh-locked{{/unless}} {{#if temaScuro}}dh-dark{{/if}}">

{{!-- === HEADER === --}}
<header class="dh-character-header">
  <div class="dh-portrait">
    <img src="{{actor.img}}" data-edit="img" alt="{{actor.name}}"/>
  </div>
  <div class="dh-id">
    <input type="text" name="name" value="{{actor.name}}" placeholder="Nome del personaggio" class="dh-name" {{#unless editMode}}readonly{{/unless}}/>
    <div class="dh-meta-row">
      <label class="dh-meta-grow">Classe
        <select data-sel="classe">
          <option value="">— scegli —</option>
          {{#each dbClassi as |c|}}<option value="{{c}}" {{#if (eq c ../system.classe)}}selected{{/if}}>{{c}}</option>{{/each}}
        </select>
      </label>
      <label class="dh-meta-grow">Sottoclasse
        <select data-sel="sottoclasse">
          <option value="">— scegli —</option>
          {{#each dbSottoclassi as |c|}}<option value="{{c}}" {{#if (eq c ../system.sottoclasse)}}selected{{/if}}>{{c}}</option>{{/each}}
        </select>
      </label>
    </div>
    <div class="dh-meta-row">
      <label class="dh-meta-grow">Discendenza
        <select data-sel="discendenza">
          <option value="">— scegli —</option>
          {{#each dbDiscendenze as |c|}}<option value="{{c}}" {{#if (eq c ../system.retaggio)}}selected{{/if}}>{{c}}</option>{{/each}}
        </select>
      </label>
      <label class="dh-meta-grow">Comunità
        <select data-sel="comunita">
          <option value="">— scegli —</option>
          {{#each dbComunita as |c|}}<option value="{{c}}" {{#if (eq c ../system.comunita)}}selected{{/if}}>{{c}}</option>{{/each}}
        </select>
      </label>
      <label class="dh-meta-num">Liv. <input type="number" name="system.livello.value" value="{{system.livello.value}}" min="1" max="10" {{#unless editMode}}readonly{{/unless}}/></label>
      <label class="dh-meta-num">Tier <input type="number" value="{{system.tier}}" disabled title="Tier equipaggiamento"/></label>
      <label class="dh-meta-num">Rango <input type="number" value="{{system.rango}}" disabled title="Rango avanzamenti"/></label>
    </div>
  </div>
</header>

{{!-- === TAB BAR: tabs a sinistra, lock + riposi a destra === --}}
<div class="dh-tab-bar">
  <nav class="dh-tabs">
    {{#each tabs as |t|}}
      <a class="dh-tab {{#if t.active}}active{{/if}}" data-action="changeTab" data-tab="{{t.id}}">
        <i class="fa-solid {{t.icon}}"></i> {{t.label}}
      </a>
    {{/each}}
  </nav>
  <div class="dh-tab-bar-actions">
    <button type="button" class="dh-btn dh-btn-icon-only {{#if editMode}}dh-lock-active{{/if}}"
            data-action="toggleEditMode"
            title="{{#if editMode}}Modifica attiva (click per bloccare){{else}}Modifica bloccata (click per sbloccare){{/if}}"
            aria-label="Toggle Modifica">
      <i class="fa-solid {{#if editMode}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
    </button>
    <button type="button" class="dh-btn dh-btn-icon-only" data-action="shortRest" title="Riposo Breve" aria-label="Riposo Breve">
      <i class="fa-solid fa-mug-saucer"></i>
    </button>
    <button type="button" class="dh-btn dh-btn-icon-only dh-btn-primary" data-action="longRest" title="Riposo Lungo" aria-label="Riposo Lungo">
      <i class="fa-solid fa-bed"></i>
    </button>
    <button type="button" class="dh-btn dh-btn-icon-only dh-btn-level" data-action="avanzamento" title="Sali di Livello" aria-label="Avanzamento">
      <i class="fa-solid fa-arrow-up-right-dots"></i>
    </button>
  </div>
</div>

{{!-- === TAB: PERSONAGGIO === --}}
<section class="dh-tab-content {{#if (eq currentTab 'main')}}active{{/if}}" data-tab-content="main">

  <div class="dh-block">
    <h3 class="dh-block-title">Tratti
      <div class="dh-roll-mode" role="radiogroup" aria-label="Modalità tiro">
        <button type="button" class="dh-mode-btn {{#if (eq rollMode 'svantaggio')}}active{{/if}}"
                data-action="setRollMode" data-mode="svantaggio" title="Svantaggio (−1d6)" aria-label="Svantaggio">
          <i class="fa-solid fa-circle-minus"></i>
        </button>
        <button type="button" class="dh-mode-btn {{#if (eq rollMode 'normale')}}active{{/if}}"
                data-action="setRollMode" data-mode="normale" title="Tiro normale" aria-label="Normale">
          <i class="fa-solid fa-equals"></i>
        </button>
        <button type="button" class="dh-mode-btn {{#if (eq rollMode 'vantaggio')}}active{{/if}}"
                data-action="setRollMode" data-mode="vantaggio" title="Vantaggio (+1d6)" aria-label="Vantaggio">
          <i class="fa-solid fa-circle-plus"></i>
        </button>
      </div>
    </h3>
    <div class="dh-tratti-grid">
      {{#each trattiList as |t|}}
        <div class="dh-tratto-card">
          <button type="button" class="dh-tratto-tira" data-action="tiraTratto" data-tratto="{{t.key}}" title="Tira {{t.label}}">
            <span class="dh-tratto-nome">{{t.label}}</span>
            <span class="dh-tratto-val">{{t.segno}}{{t.valore}}</span>
          </button>
          {{#if ../editMode}}
          <div class="dh-tratto-edit dh-tratto-stepper">
            <button type="button" class="dh-tratto-step dh-tratto-step-minus" data-action="trattoStep" data-tratto="{{t.key}}" data-delta="-1" title="Diminuisci">−</button>
            <span class="dh-tratto-step-val">{{t.valore}}</span>
            <button type="button" class="dh-tratto-step dh-tratto-step-plus" data-action="trattoStep" data-tratto="{{t.key}}" data-delta="1" title="Aumenta">+</button>
          </div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">Tracce</h3>
    <div class="dh-tracks-grid">

      <div class="dh-track">
        <h4>Punti Ferita <span class="dh-track-num">{{system.pf.value}}/{{system.pf.max}}</span></h4>
        <div class="dh-cells-row">
          {{#each cellsPf as |c|}}
            <span class="dh-cell pf {{#if c.filled}}filled{{/if}}" data-action="togglePf" data-idx="{{c.i}}"></span>
          {{/each}}
          <input type="number" name="system.pf.max" value="{{system.pf.max}}" min="1" max="20" class="dh-track-max" {{#unless editMode}}readonly{{/unless}}/>
        </div>
      </div>

      <div class="dh-track">
        <h4>Stress <span class="dh-track-num">{{system.stress.value}}/{{system.stress.max}}</span></h4>
        <div class="dh-cells-row">
          {{#each cellsStress as |c|}}
            <span class="dh-cell stress {{#if c.filled}}filled{{/if}}" data-action="toggleStress" data-idx="{{c.i}}"></span>
          {{/each}}
          <input type="number" name="system.stress.max" value="{{system.stress.max}}" min="1" max="20" class="dh-track-max" {{#unless editMode}}readonly{{/unless}}/>
        </div>
      </div>

      <div class="dh-track">
        <h4>Armatura
          {{#if armaturaEquip}}<span class="dh-armor-name">{{armaturaEquip.name}}</span>{{/if}}
          <span class="dh-track-num">{{system.armatura.value}}/{{system.armatura.max}}</span>
        </h4>
        <div class="dh-cells-row">
          {{#each cellsArmor as |c|}}
            <span class="dh-cell armor {{#if c.filled}}filled{{/if}}" data-action="toggleArmatura" data-idx="{{c.i}}"></span>
          {{/each}}
          {{#unless cellsArmor.length}}<em class="dh-track-empty">Equipaggia un'armatura</em>{{/unless}}
        </div>
      </div>

      <div class="dh-track">
        <h4>Speranza <span class="dh-track-num">{{system.speranza.value}}/{{system.speranza.max}}</span></h4>
        <div class="dh-cells-row">
          {{#each cellsHope as |c|}}
            <span class="dh-cell hope {{#if c.filled}}filled{{/if}}"></span>
          {{/each}}
          <button type="button" class="dh-btn-mini" data-action="spendiSperanza" data-amount="1" title="Spendi 1 Speranza">−1</button>
        </div>
      </div>
    </div>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">Difesa
      {{#if armaturaEquip}}<span class="dh-info">Valori da {{armaturaEquip.name}}</span>{{/if}}
    </h3>
    <div class="dh-difesa-grid">
      <button type="button" class="dh-readout dh-readout-click" data-action="modEvasione" title="Clicca per modificare l'Evasione base">
        <span class="dh-readout-label">Evasione</span>
        <strong class="dh-readout-val">{{system.evasione.totale}}</strong>
      </button>
      <button type="button" class="dh-readout dh-readout-click" data-action="modSoglie" title="Clicca per modificare le Soglie">
        <span class="dh-readout-label">Soglia Maggiore</span>
        <strong class="dh-readout-val">{{system.soglie.maggioreTot}}</strong>
      </button>
      <button type="button" class="dh-readout dh-readout-click" data-action="modSoglie" title="Clicca per modificare le Soglie">
        <span class="dh-readout-label">Soglia Grave</span>
        <strong class="dh-readout-val">{{system.soglie.graveTot}}</strong>
      </button>
      <div class="dh-difesa-extra">
        <label class="dh-competenza-label">Competenza
          <input type="number" name="system.competenza.value" value="{{system.competenza.value}}" min="1" max="6" {{#unless editMode}}readonly{{/unless}}/>
        </label>
        <span class="dh-info">sotto Maggiore = 1 PF · tra Maggiore e Grave = 2 PF · oltre Grave = 3 PF</span>
      </div>
    </div>
  </div>

  <div class="dh-block dh-modificatori">
    <h3 class="dh-block-title">Modificatori attivi</h3>
    {{#if bonus.toggles.length}}
      <div class="dh-toggles">
        {{#each bonus.toggles as |t|}}
          <label class="dh-toggle {{#if (lookup ../bonusAttivi t.key)}}on{{/if}}">
            <input type="checkbox" data-action="toggleBonus" data-key="{{t.key}}" {{#if (lookup ../bonusAttivi t.key)}}checked{{/if}}/>
            <span class="dh-toggle-label">{{t.label}}</span>
            <span class="dh-toggle-note">{{t.note}}</span>
          </label>
        {{/each}}
      </div>
    {{/if}}
    {{#if bonus.voci.length}}
      <ul class="dh-bonus-list">
        {{#each bonus.voci as |v|}}
          <li>
            <span class="dh-bonus-label">{{v.label}}</span>
            <span class="dh-bonus-vals">
              {{#if v.dEv}}<span class="dh-bv">Ev {{#if (gte v.dEv 0)}}+{{/if}}{{v.dEv}}</span>{{/if}}
              {{#if v.dMod}}<span class="dh-bv">Magg {{#if (gte v.dMod 0)}}+{{/if}}{{v.dMod}}</span>{{/if}}
              {{#if v.dGra}}<span class="dh-bv">Grave {{#if (gte v.dGra 0)}}+{{/if}}{{v.dGra}}</span>{{/if}}
              {{#if v.dSlot}}<span class="dh-bv">Arm {{#if (gte v.dSlot 0)}}+{{/if}}{{v.dSlot}}</span>{{/if}}
            </span>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="dh-empty">Nessun modificatore attivo.</p>
    {{/if}}
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">
      Esperienze
      <button type="button" class="dh-btn-mini dh-edit-only" data-action="itemCreate" data-type="experience">+ Aggiungi</button>
    </h3>
    <ul class="dh-list">
      {{#each esperienze as |it|}}
        <li class="dh-list-item" data-item-id="{{it.id}}">
          <strong>{{it.name}}</strong>
          <span class="dh-exp-bonus">+{{it.system.bonus}}</span>
          <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}<li class="dh-empty">Nessuna esperienza.</li>{{/each}}
    </ul>
  </div>
</section>

{{!-- === TAB: EQUIPAGGIAMENTO === --}}
<section class="dh-tab-content {{#if (eq currentTab 'equip')}}active{{/if}}" data-tab-content="equip">

  <div class="dh-block">
    <h3 class="dh-block-title">
      Armi
      <span class="dh-info">trascina dalla cartella Armi</span>
      <button type="button" class="dh-btn-mini dh-edit-only" data-action="itemCreate" data-type="weapon">+ Manuale</button>
    </h3>
    <ul class="dh-list">
      {{#each armi as |w|}}
        <li class="dh-list-item" data-item-id="{{w.id}}">
          <span class="dh-arma-cat">{{w.system.categoria}}</span>
          <strong class="dh-arma-nome">{{w.name}}</strong>
          <span class="dh-arma-info">{{w.system.tratto}} · {{w.system.portata}} · {{w.system.dannoFormula}} {{w.system.danno.tipoDanno}}</span>
          <button type="button" class="dh-btn-mini" data-action="tiraArma" title="Attacca">⚔</button>
          <button type="button" class="dh-btn-mini" data-action="tiraDanno" title="Danno">💥</button>
          <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}<li class="dh-empty">Nessuna arma.</li>{{/each}}
    </ul>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">
      Armature
      <span class="dh-info">trascina dalla cartella Armature</span>
      <button type="button" class="dh-btn-mini dh-edit-only" data-action="itemCreate" data-type="armor">+ Manuale</button>
    </h3>
    <ul class="dh-list">
      {{#each armature as |a|}}
        <li class="dh-list-item" data-item-id="{{a.id}}">
          <input type="checkbox" {{#if a.system.equipaggiato}}checked{{/if}} data-action="itemEquip" title="Equipaggia"/>
          <strong>{{a.name}}</strong>
          <span class="dh-arma-info">Sg.M {{a.system.sogliaMaggiore}} · Sg.G {{a.system.sogliaGrave}} · {{a.system.caselleArmatura}} caselle</span>
          {{#if a.system.speciale}}<em>· {{a.system.speciale}}</em>{{/if}}
          <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}<li class="dh-empty">Nessuna armatura.</li>{{/each}}
    </ul>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">
      Inventario
      <span class="dh-edit-only">
        <button type="button" class="dh-btn-mini" data-action="itemCreate" data-type="inventory">+ Oggetto</button>
        <button type="button" class="dh-btn-mini" data-action="itemCreate" data-type="consumable">+ Scorta</button>
      </span>
    </h3>
    <ul class="dh-list">
      {{#each inventario as |it|}}
        <li class="dh-list-item" data-item-id="{{it.id}}">
          <strong>{{it.name}}</strong>
          <span>×{{it.system.quantita}}</span>
          {{#if (eq it.type "consumable")}}<span class="dh-arma-info">({{it.system.usi.value}}/{{it.system.usi.max}})</span>{{/if}}
          <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}<li class="dh-empty">Inventario vuoto.</li>{{/each}}
    </ul>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">Oro</h3>
    <div class="dh-oro-grid">
      <label>Manciate <input type="number" name="system.oro.manciate" value="{{system.oro.manciate}}" min="0" {{#unless editMode}}readonly{{/unless}}/></label>
      <label>Sacchi <input type="number" name="system.oro.sacchi" value="{{system.oro.sacchi}}" min="0" {{#unless editMode}}readonly{{/unless}}/></label>
      <label>Scrigni <input type="number" name="system.oro.scrigni" value="{{system.oro.scrigni}}" min="0" {{#unless editMode}}readonly{{/unless}}/></label>
    </div>
  </div>
</section>

{{!-- === TAB: DOMINI & PRIVILEGI === --}}
<section class="dh-tab-content {{#if (eq currentTab 'domini')}}active{{/if}}" data-tab-content="domini">

  <div class="dh-block">
    <h3 class="dh-block-title">
      Carte Dominio
      <span class="dh-info">Dotazione max: {{system.carteDotazione.max}}</span>
    </h3>
    <div class="dh-add-row">
      <select data-add="carta">
        <option value="">— scegli una carta ({{dbCarte.length}} disponibili) —</option>
        {{#each dbCarte as |c|}}<option value="{{c.dominio}}||{{c.nome}}">[{{c.dominio}}] Lv{{c.livello}} · {{c.nome}}</option>{{/each}}
      </select>
      <button type="button" class="dh-btn-mini" data-action="aggiungiCarta">+ Aggiungi</button>
    </div>
    <ul class="dh-list">
      {{#each dominii as |c|}}
        <li class="dh-list-item dh-list-item-vert" data-item-id="{{c.id}}">
          <div class="dh-row">
            <span class="dh-dominio-badge">{{c.system.dominio}}</span>
            <strong>{{c.name}}</strong>
            <span class="dh-arma-info">Lv {{c.system.livello}} · {{c.system.tipo}}</span>
            {{#if c.system.ricarica}}<span class="dh-ricarica-badge"><i class="fa-solid fa-rotate"></i> {{c.system.ricarica}}</span>{{/if}}
            <div class="dh-item-actions">
              {{#if (gt c.system.costoSperanza 0)}}<span class="dh-costo-badge"><i class="fa-solid fa-star"></i> ×{{c.system.costoSperanza}}</span>{{/if}}
              <button type="button" class="dh-btn-mini dh-btn-attiva" data-action="attivaItem" title="Attiva / usa questa carta">▶ Usa</button>
              {{#if (gt c.system.gettoni.max 0)}}
              <span class="dh-gettoni">
                <button type="button" class="dh-btn-icon" data-action="gettoniStep" data-delta="-1" title="Rimuovi gettone">−</button>
                <span class="dh-gettoni-val">{{c.system.gettoni.value}}/{{c.system.gettoni.max}}</span>
                <button type="button" class="dh-btn-icon" data-action="gettoniStep" data-delta="1" title="Aggiungi gettone">+</button>
              </span>
              {{/if}}
              <button type="button" class="dh-btn-icon" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
              <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
          {{#if c.system.description}}<div class="dh-desc">{{c.system.description}}</div>{{/if}}
        </li>
      {{else}}<li class="dh-empty">Nessuna carta. Trascinala dalla cartella "Carte Dominio".</li>{{/each}}
    </ul>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">
      Privilegi
      <button type="button" class="dh-btn-mini dh-edit-only" data-action="itemCreate" data-type="feature">+ Privilegio</button>
    </h3>
    <ul class="dh-list">
      {{#each privilegi as |f|}}
        <li class="dh-list-item dh-list-item-vert" data-item-id="{{f.id}}">
          <div class="dh-row">
            <strong>{{f.name}}</strong>
            <span class="dh-feat-tipo">{{f.system.tipoPrivilegio}}</span>
            {{#if f.system.fonte}}<span class="dh-feat-fonte">{{f.system.fonte}}</span>{{/if}}
            {{#if f.system.ricarica}}<span class="dh-ricarica-badge"><i class="fa-solid fa-rotate"></i> {{f.system.ricarica}}</span>{{/if}}
            <div class="dh-item-actions">
              {{#if (gt f.system.costoSperanza 0)}}<span class="dh-costo-badge"><i class="fa-solid fa-star"></i> ×{{f.system.costoSperanza}}</span>{{/if}}
              {{#unless (eq f.system.tipoPrivilegio "Passiva")}}
              <button type="button" class="dh-btn-mini dh-btn-attiva" data-action="attivaItem" title="Attiva questo privilegio">▶ Usa</button>
              {{/unless}}
              {{#if (gt f.system.gettoni.max 0)}}
              <span class="dh-gettoni">
                <button type="button" class="dh-btn-icon" data-action="gettoniStep" data-delta="-1" title="Rimuovi gettone">−</button>
                <span class="dh-gettoni-val">{{f.system.gettoni.value}}/{{f.system.gettoni.max}}</span>
                <button type="button" class="dh-btn-icon" data-action="gettoniStep" data-delta="1" title="Aggiungi gettone">+</button>
              </span>
              {{/if}}
              <button type="button" class="dh-btn-icon" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
              <button type="button" class="dh-btn-icon dh-edit-only" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
          {{#if f.system.description}}<div class="dh-desc">{{f.system.description}}</div>{{/if}}
        </li>
      {{else}}<li class="dh-empty">Nessun privilegio.</li>{{/each}}
    </ul>
  </div>
</section>

{{!-- === TAB: FORME BESTIALI (Druido) === --}}
<section class="dh-tab-content {{#if (eq currentTab 'bestie')}}active{{/if}}" data-tab-content="bestie">
  {{#if formaAttiva}}
    <div class="dh-block dh-forma-attiva">
      <h3 class="dh-block-title">
        <i class="fa-solid fa-paw"></i> Forma attiva: {{formaAttiva.nome}}
        <button type="button" class="dh-btn-mini" data-action="tornaUmano">Torna umano</button>
      </h3>
      <div class="dh-forma-stats">
        <span><strong>Tratto:</strong> {{formaAttiva.tratto}}</span>
        <span><strong>Evasione:</strong> +{{formaAttiva.ev}}</span>
        <span><strong>Attacco:</strong> {{formaAttiva.atk.t}} · {{formaAttiva.atk.p}} · {{formaAttiva.atk.d}}{{#if formaAttiva.atk.b}}+{{formaAttiva.atk.b}}{{/if}}</span>
      </div>
      <div class="dh-forma-abilita">
        {{#each formaAttiva.abilita as |a|}}
          <div class="dh-priv-item"><strong>{{a.n}}</strong><div class="dh-desc">{{a.d}}</div></div>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <div class="dh-block">
    <h3 class="dh-block-title">Forme disponibili <span class="dh-info">(rango ≤ {{system.rango}})</span></h3>
    <div class="dh-forme-grid">
      {{#each formeBestiali as |f|}}
        <div class="dh-forma-card">
          <div class="dh-forma-card-h">
            <span class="dh-forma-rango">R{{f.r}}</span>
            <strong>{{f.nome}}</strong>
            <button type="button" class="dh-btn-mini" data-action="trasforma" data-nome="{{f.nome}}">Trasforma</button>
          </div>
          <div class="dh-forma-esempi">{{f.esempi}}</div>
          <div class="dh-forma-meta">{{f.tratto}} · Ev +{{f.ev}} · {{f.atk.d}}{{#if f.atk.b}}+{{f.atk.b}}{{/if}} {{f.atk.t}}</div>
          {{#each f.abilita as |a|}}
            <div class="dh-forma-ab"><strong>{{a.n}}:</strong> {{a.d}}</div>
          {{/each}}
        </div>
      {{else}}
        <p class="dh-empty">Nessuna forma disponibile.</p>
      {{/each}}
    </div>
  </div>
</section>

{{!-- === TAB: COMPAGNO (Ranger) === --}}
<section class="dh-tab-content {{#if (eq currentTab 'compagno')}}active{{/if}}" data-tab-content="compagno">
  <div class="dh-block">
    <h3 class="dh-block-title"><i class="fa-solid fa-dog"></i> Scheda del Compagno</h3>
    <div class="dh-grid-2">
      <label>Nome <input type="text" name="system.compagno.nome" value="{{compagno.nome}}"/></label>
      <label>Tipo animale <input type="text" name="system.compagno.tipo" value="{{compagno.tipo}}" placeholder="lupo, falco…"/></label>
    </div>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">Statistiche</h3>
    <div class="dh-difesa-grid">
      <label>Evasione <input type="number" name="system.compagno.evasione" value="{{compagno.evasione}}"/></label>
      <div class="dh-track" style="grid-column: 2 / 4;">
        <h4>Stress <span class="dh-track-num">{{compagno.stress.value}}/{{compagno.stress.max}}</span></h4>
        <div class="dh-cells-row">
          {{#each cmpStressCells as |c|}}
            <span class="dh-cell stress {{#if c.filled}}filled{{/if}}" data-action="cmpStress" data-idx="{{c.i}}"></span>
          {{/each}}
          <button type="button" class="dh-btn-mini" data-action="cmpStressMax" data-delta="-1">−</button>
          <button type="button" class="dh-btn-mini" data-action="cmpStressMax" data-delta="1">+</button>
        </div>
      </div>
    </div>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">Attacco</h3>
    <div class="dh-grid-2">
      <label>Nome <input type="text" name="system.compagno.attacco.nome" value="{{compagno.attacco.nome}}"/></label>
      <label>Portata <input type="text" name="system.compagno.attacco.portata" value="{{compagno.attacco.portata}}"/></label>
      <label>Dado <input type="text" name="system.compagno.attacco.dado" value="{{compagno.attacco.dado}}"/></label>
      <label>Bonus <input type="number" name="system.compagno.attacco.bonus" value="{{compagno.attacco.bonus}}"/></label>
    </div>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">Esperienza & Potenziamenti</h3>
    <label>Esperienza <input type="text" name="system.compagno.esperienza" value="{{compagno.esperienza}}"/></label>
  </div>
</section>

{{!-- === TAB: BIOGRAFIA === --}}
<section class="dh-tab-content {{#if (eq currentTab 'bio')}}active{{/if}}" data-tab-content="bio">
  <div class="dh-block">
    <h3 class="dh-block-title">Aspetto, pronomi, note</h3>
    <label>Pronomi <input type="text" name="system.details.pronomi" value="{{system.details.pronomi}}" {{#unless editMode}}readonly{{/unless}}/></label>
    <label>Aspetto <textarea name="system.details.aspetto" rows="3" {{#unless editMode}}readonly{{/unless}}>{{system.details.aspetto}}</textarea></label>
  </div>
  <div class="dh-block">
    <h3 class="dh-block-title">Biografia</h3>
    <textarea name="system.details.bio" rows="12" style="width: 100%;" {{#unless editMode}}readonly{{/unless}}>{{system.details.bio}}</textarea>
  </div>
  <div class="dh-block">
    <h3 class="dh-block-title">Note</h3>
    <textarea name="system.details.notes" rows="6" style="width: 100%;" {{#unless editMode}}readonly{{/unless}}>{{system.details.notes}}</textarea>
  </div>
</section>
</div>
