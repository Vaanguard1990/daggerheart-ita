<div class="dh-tracker">
  <section class="dh-tracker-fear">
    <h3><i class="fa-solid fa-skull"></i> Paura del GM <span class="dh-tracker-num">{{paura}} / {{max}}</span></h3>
    <div class="dh-tracker-cells">
      {{#each pauraCells as |on|}}
        <span class="dh-tracker-cell dh-cell-fear {{#if on}}filled{{/if}}"></span>
      {{/each}}
    </div>
    {{#if isGM}}
    <div class="dh-tracker-buttons">
      <button type="button" data-action="addFear">+1</button>
      <button type="button" data-action="subFear">−1</button>
    </div>
    {{/if}}
  </section>

  <section class="dh-tracker-hope">
    <h3><i class="fa-solid fa-sun"></i> Speranza condivisa <span class="dh-tracker-num">{{speranzaGruppo}}</span></h3>
    {{#if isGM}}
    <div class="dh-tracker-buttons">
      <button type="button" data-action="addHope">+1</button>
      <button type="button" data-action="subHope">−1</button>
    </div>
    {{/if}}
  </section>

  {{#if isGM}}
  <div class="dh-tracker-footer">
    <button type="button" data-action="reset" class="dh-btn-warn">Reset</button>
  </div>
  {{/if}}
</div>
