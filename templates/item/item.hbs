<div class="dh-item-sheet dh-item-{{type}}">
  <header class="dh-item-header">
    <img src="{{item.img}}" data-edit="img" class="dh-item-img"/>
    <input type="text" name="name" value="{{item.name}}" class="dh-item-nome"/>
    <span class="dh-item-type">{{type}}</span>
  </header>

  <div class="dh-item-body">
    {{#if (eq type "weapon")}}     {{> "systems/daggerheart-ita/templates/item/parts/weapon.hbs"}}     {{/if}}
    {{#if (eq type "armor")}}      {{> "systems/daggerheart-ita/templates/item/parts/armor.hbs"}}      {{/if}}
    {{#if (eq type "ancestry")}}   {{> "systems/daggerheart-ita/templates/item/parts/ancestry.hbs"}}   {{/if}}
    {{#if (eq type "community")}}  {{> "systems/daggerheart-ita/templates/item/parts/community.hbs"}}  {{/if}}
    {{#if (eq type "class")}}      {{> "systems/daggerheart-ita/templates/item/parts/class.hbs"}}      {{/if}}
    {{#if (eq type "subclass")}}   {{> "systems/daggerheart-ita/templates/item/parts/subclass.hbs"}}   {{/if}}
    {{#if (eq type "domainCard")}} {{> "systems/daggerheart-ita/templates/item/parts/domainCard.hbs"}} {{/if}}
    {{#if (eq type "feature")}}    {{> "systems/daggerheart-ita/templates/item/parts/feature.hbs"}}    {{/if}}
    {{#if (eq type "experience")}} {{> "systems/daggerheart-ita/templates/item/parts/experience.hbs"}} {{/if}}
    {{#if (eq type "consumable")}} {{> "systems/daggerheart-ita/templates/item/parts/consumable.hbs"}} {{/if}}
    {{#if (eq type "inventory")}}  {{> "systems/daggerheart-ita/templates/item/parts/inventory.hbs"}}  {{/if}}
    {{#if (eq type "beastForm")}}  {{> "systems/daggerheart-ita/templates/item/parts/beastForm.hbs"}}  {{/if}}
  </div>

  <div class="dh-item-desc">
    <h4>Descrizione</h4>
    <textarea name="system.description" rows="8">{{system.description}}</textarea>
  </div>
</div>
