<div class="dh-grid-2">
  <label>Tipo
    <select name="system.tipoPrivilegio">
      <option {{#if (eq system.tipoPrivilegio "Generico")}}selected{{/if}}>Generico</option>
      <option {{#if (eq system.tipoPrivilegio "Passiva")}}selected{{/if}}>Passiva</option>
      <option {{#if (eq system.tipoPrivilegio "Azione")}}selected{{/if}}>Azione</option>
      <option {{#if (eq system.tipoPrivilegio "Reazione")}}selected{{/if}}>Reazione</option>
    </select>
  </label>
  <label>Fonte <input type="text" name="system.fonte" value="{{system.fonte}}"/></label>
  <label class="dh-full">Ricarica <input type="text" name="system.ricarica" value="{{system.ricarica}}"/></label>
  <label>Costo Speranza <input type="number" name="system.costoSperanza" value="{{system.costoSperanza}}" min="0" max="10" title="Punti Speranza spesi all'attivazione (0 = gratuito)"/></label>
  <label>Costo Paura <input type="number" name="system.costoPaura" value="{{system.costoPaura}}" min="0" max="10" title="Paura spesa all'attivazione — per avversari/ambienti (0 = gratuito)"/></label>
  <label>Costo Stress <input type="number" name="system.costoStress" value="{{system.costoStress}}" min="0" max="10" title="Stress marcato all'attivazione (richiede conferma del giocatore)"/></label>
  <label>Gettoni max <input type="number" name="system.gettoni.max" value="{{system.gettoni.max}}" min="0" max="20" title="0 = nessun contatore gettoni"/></label>
</div>
<fieldset class="dh-fieldset">
  <legend>Countdown</legend>
  <div class="dh-grid-2">
    <label>Nome <input type="text" name="system.countdown.nome" value="{{system.countdown.nome}}" placeholder="es. Ritirata"/></label>
    <label>Soglia <input type="number" name="system.countdown.max" value="{{system.countdown.max}}" min="0" max="20" title="0 = nessun countdown"/></label>
    <label>Tipo
      <select name="system.countdown.tipo">
        <option value="regressivo"  {{#if (eq system.countdown.tipo "regressivo")}}selected{{/if}}>↓ Regressivo</option>
        <option value="progressivo" {{#if (eq system.countdown.tipo "progressivo")}}selected{{/if}}>↑ Progressivo</option>
      </select>
    </label>
  </div>
</fieldset>
