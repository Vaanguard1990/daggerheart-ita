<div class="dh-grid-2">
  <label>Tipo
    <select name="system.tipoPrivilegio">
      <option {{#if (eq system.tipoPrivilegio "Generico")}}selected{{/if}}>Generico</option>
      <option {{#if (eq system.tipoPrivilegio "Passiva")}}selected{{/if}}>Passiva</option>
      <option {{#if (eq system.tipoPrivilegio "Azione")}}selected{{/if}}>Azione</option>
      <option {{#if (eq system.tipoPrivilegio "Reazione")}}selected{{/if}}>Reazione</option>
    </select>
  </label>
  <label>Fonte <input type="text" name="system.fonte" value="{{system.fonte}}"/></label>
  <label class="dh-full">Ricarica <input type="text" name="system.ricarica" value="{{system.ricarica}}"/></label>
</div>
