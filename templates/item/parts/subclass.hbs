<div class="dh-grid-2">
  <label>Classe <input type="text" name="system.classe" value="{{system.classe}}"/></label>
  <label>Tratto incantatore <input type="text" name="system.spellcast" value="{{system.spellcast}}"/></label>
</div>
<fieldset><legend>Fondamento</legend>
  <label>Nome <input type="text" name="system.fondamento.nome" value="{{system.fondamento.nome}}"/></label>
  <label>Descrizione <textarea name="system.fondamento.descrizione" rows="3">{{system.fondamento.descrizione}}</textarea></label>
</fieldset>
<fieldset><legend>Specializzazione</legend>
  <label>Nome <input type="text" name="system.specializzazione.nome" value="{{system.specializzazione.nome}}"/></label>
  <label>Descrizione <textarea name="system.specializzazione.descrizione" rows="3">{{system.specializzazione.descrizione}}</textarea></label>
</fieldset>
<fieldset><legend>Maestria</legend>
  <label>Nome <input type="text" name="system.maestria.nome" value="{{system.maestria.nome}}"/></label>
  <label>Descrizione <textarea name="system.maestria.descrizione" rows="3">{{system.maestria.descrizione}}</textarea></label>
</fieldset>
