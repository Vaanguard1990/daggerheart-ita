<div class="dh-grid-2">
  <label>Categoria
    <select name="system.categoria">
      {{#each config.categorieArma as |c|}}<option value="{{c}}" {{#if (eq c ../system.categoria)}}selected{{/if}}>{{c}}</option>{{/each}}
    </select>
  </label>
  <label>Tratto
    <select name="system.tratto">
      {{#each config.tratti as |label key|}}<option value="{{label}}" {{#if (eq label ../system.tratto)}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </label>
  <label>Portata
    <select name="system.portata">
      {{#each config.portate as |p|}}<option value="{{p}}" {{#if (eq p ../system.portata)}}selected{{/if}}>{{p}}</option>{{/each}}
    </select>
  </label>
  <label>Tier
    <input type="number" name="system.tier" value="{{system.tier}}" min="1" max="4"/>
  </label>
  <label>N° dadi
    <input type="number" name="system.danno.numDadi" value="{{system.danno.numDadi}}" min="1" max="10"/>
  </label>
  <label>Dado
    <select name="system.danno.dado">
      {{#each config.dadiDanno as |d|}}<option value="{{d}}" {{#if (eq d ../system.danno.dado)}}selected{{/if}}>{{d}}</option>{{/each}}
    </select>
  </label>
  <label>Bonus danno
    <input type="number" name="system.danno.bonus" value="{{system.danno.bonus}}"/>
  </label>
  <label>Tipo danno
    <select name="system.danno.tipoDanno">
      <option value="fisico" {{#if (eq system.danno.tipoDanno "fisico")}}selected{{/if}}>Fisico</option>
      <option value="magico" {{#if (eq system.danno.tipoDanno "magico")}}selected{{/if}}>Magico</option>
    </select>
  </label>
  <label>Magica
    <input type="checkbox" name="system.magica" {{checked system.magica}}/>
  </label>
  <label>Due mani
    <input type="checkbox" name="system.dueMani" {{checked system.dueMani}}/>
  </label>
  <label class="dh-full">Speciale
    <input type="text" name="system.speciale" value="{{system.speciale}}"/>
  </label>
</div>
