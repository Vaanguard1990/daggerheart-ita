<div class="dh-sheet-root">
{{!-- === HEADER === --}}
<header class="dh-character-header">
  <div class="dh-portrait">
    <img src="{{actor.img}}" data-edit="img" alt="{{actor.name}}"/>
  </div>
  <div class="dh-id">
    <input type="text" name="name" value="{{actor.name}}" placeholder="Nome del personaggio" class="dh-name"/>
    <div class="dh-meta-row">
      <label class="dh-meta-grow">Classe <input type="text" name="system.classe" value="{{system.classe}}"/></label>
      <label class="dh-meta-grow">Sottoclasse <input type="text" name="system.sottoclasse" value="{{system.sottoclasse}}"/></label>
    </div>
    <div class="dh-meta-row">
      <label class="dh-meta-grow">Discendenza <input type="text" name="system.retaggio" value="{{system.retaggio}}"/></label>
      <label class="dh-meta-grow">Comunità <input type="text" name="system.comunita" value="{{system.comunita}}"/></label>
      <label class="dh-meta-num">Liv. <input type="number" name="system.livello.value" value="{{system.livello.value}}" min="1" max="10"/></label>
      <label class="dh-meta-num">Tier <input type="number" value="{{system.tier}}" disabled/></label>
    </div>
  </div>
</header>

{{!-- === TABS NAV === --}}
<nav class="dh-tabs">
  {{#each tabs as |t|}}
    <a class="dh-tab {{#if t.active}}active{{/if}}" data-action="changeTab" data-tab="{{t.id}}">
      <i class="fa-solid {{t.icon}}"></i> {{t.label}}
    </a>
  {{/each}}
</nav>

{{!-- === TAB: PERSONAGGIO === --}}
<section class="dh-tab-content {{#if (eq currentTab 'main')}}active{{/if}}" data-tab-content="main">

  <div class="dh-block">
    <h3 class="dh-block-title">Tratti <span class="dh-info">Shift=vantaggio · Ctrl=svantaggio</span></h3>
    <div class="dh-tratti-grid">
      {{#each trattiList as |t|}}
        <div class="dh-tratto-card">
          <button type="button" class="dh-tratto-tira" data-action="tiraTratto" data-tratto="{{t.key}}" title="Tira {{t.label}}">
            <span class="dh-tratto-nome">{{t.label}}</span>
            <span class="dh-tratto-val">{{t.segno}}{{t.valore}}</span>
          </button>
          <div class="dh-tratto-edit">
            <input type="number" name="system.tratti.{{t.key}}.valore" value="{{t.valore}}" class="dh-tratto-input" title="Modifica valore"/>
          </div>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">Tracce</h3>
    <div class="dh-tracks-grid">

      <div class="dh-track">
        <h4>Punti Ferita <span class="dh-track-num">{{system.pf.value}}/{{system.pf.max}}</span></h4>
        <div class="dh-cells-row">
          {{#each cellsPf as |c|}}
            <span class="dh-cell pf {{#if c.filled}}filled{{/if}}" data-action="togglePf" data-idx="{{c.i}}"></span>
          {{/each}}
          <input type="number" name="system.pf.max" value="{{system.pf.max}}" min="1" max="20" class="dh-track-max"/>
        </div>
      </div>

      <div class="dh-track">
        <h4>Stress <span class="dh-track-num">{{system.stress.value}}/{{system.stress.max}}</span></h4>
        <div class="dh-cells-row">
          {{#each cellsStress as |c|}}
            <span class="dh-cell stress {{#if c.filled}}filled{{/if}}" data-action="toggleStress" data-idx="{{c.i}}"></span>
          {{/each}}
          <input type="number" name="system.stress.max" value="{{system.stress.max}}" min="1" max="20" class="dh-track-max"/>
        </div>
      </div>

      <div class="dh-track">
        <h4>Armatura <span class="dh-track-num">{{system.armatura.value}}/{{system.armatura.max}}</span></h4>
        <div class="dh-cells-row">
          {{#each cellsArmor as |c|}}
            <span class="dh-cell armor {{#if c.filled}}filled{{/if}}" data-action="toggleArmatura" data-idx="{{c.i}}"></span>
          {{/each}}
          {{#unless cellsArmor.length}}<em class="dh-track-empty">Equipaggia un'armatura</em>{{/unless}}
        </div>
      </div>

      <div class="dh-track">
        <h4>Speranza <span class="dh-track-num">{{system.speranza.value}}/{{system.speranza.max}}</span></h4>
        <div class="dh-cells-row">
          {{#each cellsHope as |c|}}
            <span class="dh-cell hope {{#if c.filled}}filled{{/if}}"></span>
          {{/each}}
          <button type="button" class="dh-btn-mini" data-action="spendiSperanza" data-amount="1" title="Spendi 1 Speranza">−1</button>
        </div>
      </div>
    </div>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">Difesa</h3>
    <div class="dh-difesa-grid">
      <label>Evasione (base) <input type="number" name="system.evasione.value" value="{{system.evasione.value}}"/></label>
      <div class="dh-readout"><span>Evasione totale</span><strong>{{system.evasione.totale}}</strong></div>
      <label>Competenza <input type="number" name="system.competenza.value" value="{{system.competenza.value}}" min="1" max="6"/></label>
      <label>Soglia Maggiore <input type="number" name="system.soglie.maggiore" value="{{system.soglie.maggiore}}"/></label>
      <div class="dh-readout dh-readout-alt"><span>Soglie</span><strong>{{system.soglie.maggiore}} / {{system.soglie.grave}}</strong></div>
      <label>Soglia Grave <input type="number" name="system.soglie.grave" value="{{system.soglie.grave}}"/></label>
    </div>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">
      Esperienze
      <button type="button" class="dh-btn-mini" data-action="itemCreate" data-type="experience">+ Aggiungi</button>
    </h3>
    <ul class="dh-list">
      {{#each esperienze as |it|}}
        <li class="dh-list-item" data-item-id="{{it.id}}">
          <strong>{{it.name}}</strong>
          <span class="dh-exp-bonus">+{{it.system.bonus}}</span>
          <button type="button" class="dh-btn-icon" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="dh-btn-icon" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}<li class="dh-empty">Nessuna esperienza.</li>{{/each}}
    </ul>
  </div>

  <div class="dh-riposo">
    <button type="button" class="dh-btn" data-action="shortRest"><i class="fa-solid fa-mug-saucer"></i> Riposo Breve</button>
    <button type="button" class="dh-btn dh-btn-primary" data-action="longRest"><i class="fa-solid fa-bed"></i> Riposo Lungo</button>
  </div>
</section>

{{!-- === TAB: EQUIPAGGIAMENTO === --}}
<section class="dh-tab-content {{#if (eq currentTab 'equip')}}active{{/if}}" data-tab-content="equip">

  <div class="dh-block">
    <h3 class="dh-block-title">
      Armi
      <button type="button" class="dh-btn-mini" data-action="itemCreate" data-type="weapon">+ Arma</button>
    </h3>
    <ul class="dh-list">
      {{#each armi as |w|}}
        <li class="dh-list-item" data-item-id="{{w.id}}">
          <span class="dh-arma-cat">{{w.system.categoria}}</span>
          <strong class="dh-arma-nome">{{w.name}}</strong>
          <span class="dh-arma-info">{{w.system.tratto}} · {{w.system.portata}} · {{w.system.dannoFormula}} {{w.system.danno.tipoDanno}}</span>
          <button type="button" class="dh-btn-mini" data-action="tiraArma" title="Attacca">⚔</button>
          <button type="button" class="dh-btn-mini" data-action="tiraDanno" title="Danno">💥</button>
          <button type="button" class="dh-btn-icon" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="dh-btn-icon" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}<li class="dh-empty">Nessuna arma.</li>{{/each}}
    </ul>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">
      Armature
      <button type="button" class="dh-btn-mini" data-action="itemCreate" data-type="armor">+ Armatura</button>
    </h3>
    <ul class="dh-list">
      {{#each armature as |a|}}
        <li class="dh-list-item" data-item-id="{{a.id}}">
          <input type="checkbox" {{#if a.system.equipaggiato}}checked{{/if}} data-action="itemEquip" title="Equipaggia"/>
          <strong>{{a.name}}</strong>
          <span class="dh-arma-info">Sg.M {{a.system.sogliaMaggiore}} · Sg.G {{a.system.sogliaGrave}} · {{a.system.caselleArmatura}} caselle</span>
          {{#if a.system.speciale}}<em>· {{a.system.speciale}}</em>{{/if}}
          <button type="button" class="dh-btn-icon" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="dh-btn-icon" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}<li class="dh-empty">Nessuna armatura.</li>{{/each}}
    </ul>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">
      Inventario
      <span>
        <button type="button" class="dh-btn-mini" data-action="itemCreate" data-type="inventory">+ Oggetto</button>
        <button type="button" class="dh-btn-mini" data-action="itemCreate" data-type="consumable">+ Scorta</button>
      </span>
    </h3>
    <ul class="dh-list">
      {{#each inventario as |it|}}
        <li class="dh-list-item" data-item-id="{{it.id}}">
          <strong>{{it.name}}</strong>
          <span>×{{it.system.quantita}}</span>
          {{#if (eq it.type "consumable")}}<span class="dh-arma-info">({{it.system.usi.value}}/{{it.system.usi.max}})</span>{{/if}}
          <button type="button" class="dh-btn-icon" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="dh-btn-icon" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}<li class="dh-empty">Inventario vuoto.</li>{{/each}}
    </ul>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">Oro</h3>
    <div class="dh-oro-grid">
      <label>Manciate <input type="number" name="system.oro.manciate" value="{{system.oro.manciate}}" min="0"/></label>
      <label>Sacchi <input type="number" name="system.oro.sacchi" value="{{system.oro.sacchi}}" min="0"/></label>
      <label>Scrigni <input type="number" name="system.oro.scrigni" value="{{system.oro.scrigni}}" min="0"/></label>
    </div>
  </div>
</section>

{{!-- === TAB: DOMINI & PRIVILEGI === --}}
<section class="dh-tab-content {{#if (eq currentTab 'domini')}}active{{/if}}" data-tab-content="domini">

  <div class="dh-block">
    <h3 class="dh-block-title">
      Carte Dominio
      <span class="dh-info">Dotazione max: {{system.carteDotazione.max}}</span>
      <button type="button" class="dh-btn-mini" data-action="itemCreate" data-type="domainCard">+ Carta</button>
    </h3>
    <ul class="dh-list">
      {{#each dominii as |c|}}
        <li class="dh-list-item" data-item-id="{{c.id}}">
          <span class="dh-dominio-badge">{{c.system.dominio}}</span>
          <strong>{{c.name}}</strong>
          <span class="dh-arma-info">Lv {{c.system.livello}} · {{c.system.tipo}}</span>
          <button type="button" class="dh-btn-icon" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="dh-btn-icon" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}<li class="dh-empty">Nessuna carta. Trascinala qui dalla cartella "Carte Dominio".</li>{{/each}}
    </ul>
  </div>

  <div class="dh-block">
    <h3 class="dh-block-title">
      Privilegi
      <button type="button" class="dh-btn-mini" data-action="itemCreate" data-type="feature">+ Privilegio</button>
    </h3>
    <ul class="dh-list">
      {{#each privilegi as |f|}}
        <li class="dh-list-item dh-list-item-vert" data-item-id="{{f.id}}">
          <div class="dh-row">
            <strong>{{f.name}}</strong>
            <span class="dh-feat-tipo">{{f.system.tipoPrivilegio}}</span>
            <button type="button" class="dh-btn-icon" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
            <button type="button" class="dh-btn-icon" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
          </div>
          {{#if f.system.description}}<div class="dh-desc">{{f.system.description}}</div>{{/if}}
        </li>
      {{else}}<li class="dh-empty">Nessun privilegio.</li>{{/each}}
    </ul>
  </div>
</section>

{{!-- === TAB: BIOGRAFIA === --}}
<section class="dh-tab-content {{#if (eq currentTab 'bio')}}active{{/if}}" data-tab-content="bio">
  <div class="dh-block">
    <h3 class="dh-block-title">Aspetto, pronomi, note</h3>
    <label>Pronomi <input type="text" name="system.details.pronomi" value="{{system.details.pronomi}}"/></label>
    <label>Aspetto <textarea name="system.details.aspetto" rows="3">{{system.details.aspetto}}</textarea></label>
  </div>
  <div class="dh-block">
    <h3 class="dh-block-title">Biografia</h3>
    <textarea name="system.details.bio" rows="12" style="width: 100%;">{{system.details.bio}}</textarea>
  </div>
  <div class="dh-block">
    <h3 class="dh-block-title">Note</h3>
    <textarea name="system.details.notes" rows="6" style="width: 100%;">{{system.details.notes}}</textarea>
  </div>
</section>
</div>
