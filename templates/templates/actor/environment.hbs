<div class="dh-sheet-root">
<header class="dh-env-header" style="border-left-color: {{tipoColore}};">
  <input type="text" name="name" value="{{actor.name}}" class="dh-env-nome"/>
  <div class="dh-row">
    <label>Tipo
      <select name="system.tipo">
        {{#each config.tipiAmbiente as |t|}}<option value="{{t}}" {{#if (eq t ../system.tipo)}}selected{{/if}}>{{t}}</option>{{/each}}
      </select>
    </label>
    <label>Rango <input type="number" name="system.rango" value="{{system.rango}}" min="1" max="4"/></label>
    <label>Difficoltà <input type="number" name="system.difficolta" value="{{system.difficolta}}"/></label>
  </div>
</header>

<nav class="dh-tabs">
  {{#each tabs as |t|}}
    <a class="dh-tab {{#if t.active}}active{{/if}}" data-action="changeTab" data-tab="{{t.id}}">
      <i class="fa-solid {{t.icon}}"></i> {{t.label}}
    </a>
  {{/each}}
</nav>

<section class="dh-tab-content {{#if (eq currentTab 'overview')}}active{{/if}}" data-tab-content="overview">
  <div class="dh-block">
    <h3 class="dh-block-title">Impeti</h3>
    <textarea name="system.impeti" rows="4" style="width:100%;">{{system.impeti}}</textarea>
  </div>
  <div class="dh-block">
    <h3 class="dh-block-title">Potenziali avversari</h3>
    <textarea name="system.potenzialiAvversari" rows="3" style="width:100%;">{{system.potenzialiAvversari}}</textarea>
  </div>
</section>

<section class="dh-tab-content {{#if (eq currentTab 'features')}}active{{/if}}" data-tab-content="features">
  <div class="dh-block">
    <h3 class="dh-block-title">
      Caratteristiche
      <button type="button" class="dh-btn-mini" data-action="itemCreate">+ Caratteristica</button>
    </h3>
    <ul class="dh-list">
      {{#each caratteristiche as |c|}}
        <li class="dh-list-item dh-list-item-vert" data-item-id="{{c.id}}">
          <div class="dh-row">
            <span class="dh-feat-tipo">{{c.system.tipoPrivilegio}}</span>
            <strong>{{c.name}}</strong>
            <button type="button" class="dh-btn-icon" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
            <button type="button" class="dh-btn-icon" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
          </div>
          {{#if c.system.description}}<div class="dh-desc">{{c.system.description}}</div>{{/if}}
        </li>
      {{else}}<li class="dh-empty">Nessuna caratteristica.</li>{{/each}}
    </ul>
  </div>
</section>

<section class="dh-tab-content {{#if (eq currentTab 'desc')}}active{{/if}}" data-tab-content="desc">
  <div class="dh-block">
    <h3 class="dh-block-title">Descrizione</h3>
    <textarea name="system.description" rows="15" style="width:100%;">{{system.description}}</textarea>
  </div>
</section>
</div>
