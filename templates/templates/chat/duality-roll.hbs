<div class="dh-duality-card {{#if critico}}dh-crit{{else}}{{#if conSperanza}}dh-hope{{else}}{{#if conPaura}}dh-fear{{/if}}{{/if}}{{/if}}">
  <header class="dh-duality-header">
    <div class="dh-duality-label">{{label}}</div>
    <div class="dh-duality-actor">{{attore}}</div>
  </header>

  <div class="dh-duality-dice">
    <div class="dh-die dh-die-hope" title="Speranza">
      <i class="fa-solid fa-sun"></i>
      <span class="dh-die-val">{{dSperanza}}</span>
    </div>
    <div class="dh-duality-vs">⚖</div>
    <div class="dh-die dh-die-fear" title="Paura">
      <i class="fa-solid fa-skull"></i>
      <span class="dh-die-val">{{dPaura}}</span>
    </div>
  </div>

  <div class="dh-duality-total">
    Totale: <strong>{{totale}}</strong>
    {{#if difficolta}}vs Diff. {{difficolta}} →
      {{#if (eq esito "successo")}}<span class="dh-ok">SUCCESSO</span>{{else}}<span class="dh-ko">FALLIMENTO</span>{{/if}}
    {{/if}}
  </div>

  <div class="dh-duality-flag">
    {{#if critico}}<span class="dh-tag dh-tag-crit">CRITICO — +1 Speranza, −1 Stress</span>
    {{else}}
      {{#if conSperanza}}<span class="dh-tag dh-tag-hope">Con Speranza — +{{speranzaGain}} Speranza</span>{{/if}}
      {{#if conPaura}}<span class="dh-tag dh-tag-fear">Con Paura — +{{paura}} Paura al GM</span>{{/if}}
    {{/if}}
  </div>

  <details class="dh-duality-tooltip">
    <summary>Dettaglio tiro · <code>{{formula}}</code></summary>
    {{{tooltip}}}
  </details>
</div>
