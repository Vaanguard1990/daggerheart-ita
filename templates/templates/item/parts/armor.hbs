<div class="dh-grid-2">
  <label>Soglia Maggiore <input type="number" name="system.sogliaMaggiore" value="{{system.sogliaMaggiore}}"/></label>
  <label>Soglia Grave <input type="number" name="system.sogliaGrave" value="{{system.sogliaGrave}}"/></label>
  <label>Caselle Armatura <input type="number" name="system.caselleArmatura" value="{{system.caselleArmatura}}"/></label>
  <label>Tier <input type="number" name="system.tier" value="{{system.tier}}" min="1" max="4"/></label>
  <label>Magica <input type="checkbox" name="system.magica" {{checked system.magica}}/></label>
  <label class="dh-full">Speciale <input type="text" name="system.speciale" value="{{system.speciale}}"/></label>
</div>
