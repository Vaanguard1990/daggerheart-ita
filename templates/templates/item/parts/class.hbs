<div class="dh-grid-2">
  <label>Evasione base <input type="number" name="system.evasioneBase" value="{{system.evasioneBase}}"/></label>
  <label>PF base <input type="number" name="system.pfBase" value="{{system.pfBase}}"/></label>
  <label>Stress base <input type="number" name="system.stressBase" value="{{system.stressBase}}"/></label>
  <label>Speranza base <input type="number" name="system.speranzaBase" value="{{system.speranzaBase}}"/></label>
  <label class="dh-full">Domini (lista) <input type="text" name="system.domini" value="{{system.domini}}" placeholder="Lama, Splendore"/></label>
  <label class="dh-full">Esperienza iniziale <input type="text" name="system.esperienzaIniziale" value="{{system.esperienzaIniziale}}"/></label>
  <label class="dh-full">Equipaggiamento iniziale <textarea name="system.equipaggiamentoIniziale" rows="3">{{system.equipaggiamentoIniziale}}</textarea></label>
</div>
<fieldset><legend>Privilegio di Classe</legend>
  <label>Nome <input type="text" name="system.privilegioClasse.nome" value="{{system.privilegioClasse.nome}}"/></label>
  <label>Descrizione <textarea name="system.privilegioClasse.descrizione" rows="4">{{system.privilegioClasse.descrizione}}</textarea></label>
</fieldset>
<fieldset><legend>Movimento Speciale</legend>
  <label>Nome <input type="text" name="system.movimentoSpe.nome" value="{{system.movimentoSpe.nome}}"/></label>
  <label>Descrizione <textarea name="system.movimentoSpe.descrizione" rows="3">{{system.movimentoSpe.descrizione}}</textarea></label>
</fieldset>
